# Copy to backend/.env and adjust. Nothing here is secret; the real .env is
# gitignored anyway so the two files cannot drift into leaking one.

HOST=127.0.0.1
PORT=8000

# Written by the training pipeline: cargo run --release -p ml
MODEL_PATH=models/house_price.ve
PREPROCESS_PATH=models/preprocess.json

# The Vite dev server. Change for a deployed frontend.
ALLOWED_ORIGIN=http://localhost:5173

RUST_LOG=backend=info,tower_http=info
